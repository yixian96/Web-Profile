{
  "claude.autoApprove": true,
  "claude.confirmEdits": false,
  "claude.confirmToolUse": false,
  "claude.autoSaveAfterEdit": true,
  "claude.showDiffBeforeApplying": false,
  "claude.requireApprovalForFileCreation": false,
  "claude.requireApprovalForFileDeletion": false,
  "claude.requireApprovalForTerminalCommands": false,
  "claude.enableAutoFix": true,
  "claude.verboseLogging": true,
  "claude.maxAutoEdits": 100,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  }
}