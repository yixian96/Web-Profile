{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-profile",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "main": ".open-next/worker.js"
}
